{
  "name": "@mrmartineau/shotframe",
  "version": "0.1.0",
  "description": "App Store screenshots from raw simulator captures: a device frame, a heading and a line of copy, rendered at exactly the size the store wants.",
  "keywords": [
    "app-store",
    "cli",
    "device-frame",
    "fastlane",
    "ios",
    "screenshots"
  ],
  "homepage": "https://github.com/mrmartineau/shotframe#readme",
  "bugs": "https://github.com/mrmartineau/shotframe/issues",
  "license": "MIT",
  "author": "Zander Martineau <hi@zander.wtf> (https://zander.wtf)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmartineau/shotframe.git"
  },
  "bin": {
    "shotframe": "bin/shotframe.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "oxlint --fix && oxfmt",
    "prepublishOnly": "npm test",
    "test": "node --test"
  },
  "devDependencies": {
    "@mrmartineau/kit": "^1.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.7.0"
}
